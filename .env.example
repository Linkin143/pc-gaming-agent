# Copy to .env and fill in. All variables are optional; the framework runs in a
# deterministic offline mode (no LLM/VLM) when keys are absent.

# --- LLM / VLM provider keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Run behaviour (PCGAF_ prefix) ---
PCGAF_GAME=minecraft
PCGAF_MAX_ITERATIONS=200
PCGAF_MAX_RECOVERY_ATTEMPTS=3
PCGAF_LOG_LEVEL=INFO
PCGAF_LOG_JSON=true

# --- Nested overrides use double underscores ---
# PCGAF_LLM__PROVIDER=openai
# PCGAF_LLM__PLANNER_MODEL=gpt-4o-mini
# PCGAF_PERCEPTION__ENABLE_VLM=true
# PCGAF_EXECUTION__DRY_RUN=false
